        <mxCell id="kc-a18" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B46504;fontColor=#B46504;exitX=0.4;exitY=0;entryX=0.192;entryY=1;" edge="1" parent="1" source="kc-a6" target="kc-a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kc-a19" value="&lt;span style=&#39;background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;&#39;&gt;4&lt;/span&gt; public keys (JWKS)&lt;br&gt;downloaded once, cached" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a18">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint x="90" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kc-a20" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="kc-a6" target="kc-a8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kc-a21" value="&lt;span style=&#39;background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;&#39;&gt;6&lt;/span&gt; route lb://CANDIDATURE&lt;br&gt;(token forwarded)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a20">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint x="0" y="-20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kc-a22" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;fontColor=#2D7600;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="kc-a8" target="kc-a6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kc-a23" value="&lt;span style=&#39;background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;&#39;&gt;7&lt;/span&gt; response" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a22">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint x="0" y="14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kc-a24" value="&lt;span style=&#39;background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;&#39;&gt;5&lt;/span&gt; the gateway checks the &lt;b&gt;signature&lt;/b&gt;, the expiry (&lt;i&gt;exp&lt;/i&gt;), the issuer (&lt;i&gt;iss&lt;/i&gt;) and the &lt;b&gt;role&lt;/b&gt; — no call to Keycloak per request." style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="452" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="kc-a25" value="&lt;b&gt;Access token (JWT) — decoded payload&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="330" height="22" as="geometry" />
        </mxCell>
        <mxCell id="kc-a26" value="{&lt;br&gt;&amp;nbsp; &quot;iss&quot;: &quot;http://localhost:8180/realms/jobboard&quot;,&lt;br&gt;&amp;nbsp; &quot;sub&quot;: &quot;4f1c…&quot;,&lt;br&gt;&amp;nbsp; &quot;preferred_username&quot;: &quot;lina&quot;,&lt;br&gt;&amp;nbsp; &quot;email&quot;: &quot;lina.mansour@example.com&quot;,&lt;br&gt;&amp;nbsp; &quot;realm_access&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &quot;roles&quot;: [&quot;CANDIDATE&quot;] },&lt;br&gt;&amp;nbsp; &quot;exp&quot;: 1792345678&lt;br&gt;}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="586" width="330" height="190" as="geometry" />
        </mxCell>
        <mxCell id="kc-a27" value="&lt;b&gt;Keycloak configuration&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="560" width="380" height="22" as="geometry" />
        </mxCell>
        <mxCell id="kc-a28" value="• Realm: &lt;b&gt;jobboard&lt;/b&gt;&lt;br&gt;• Client &lt;b&gt;jobboard-front&lt;/b&gt;: public client, Authorization Code + PKCE&lt;br&gt;• Realm roles: &lt;b&gt;CANDIDATE&lt;/b&gt;, &lt;b&gt;RECRUITER&lt;/b&gt;&lt;br&gt;• Users: e.g. lina → CANDIDATE&lt;br&gt;• Run in Docker (container port 8080 published on &lt;b&gt;8180&lt;/b&gt;, because the gateway already uses 8080)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="586" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="kc-a29" value="&lt;b&gt;Gateway side (example)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="560" width="450" height="22" as="geometry" />
        </mxCell>
        <mxCell id="kc-a30" value="# application.yml&lt;br&gt;spring.security.oauth2.resourceserver.jwt.issuer-uri:&lt;br&gt;&amp;nbsp;&amp;nbsp;http://localhost:8180/realms/jobboard&lt;br&gt;&lt;br&gt;// SecurityWebFilterChain&lt;br&gt;.pathMatchers(POST, &quot;/api/applications/**&quot;).hasRole(&quot;CANDIDATE&quot;)&lt;br&gt;.pathMatchers(POST, &quot;/api/jobs/**&quot;).hasRole(&quot;RECRUITER&quot;)&lt;br&gt;.anyExchange().authenticated()&lt;br&gt;&lt;br&gt;// a converter maps realm_access.roles → ROLE_…" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F7F7F9;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="586" width="450" height="190" as="geometry" />
        </mxCell>
        <mxCell id="kc-a31" value="Only the gateway is reachable from outside: business microservices stay in the private network (Docker network) and never handle passwords." style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="1240" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
