  <diagram name="sync-communication" id="sc">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sc-a1" value="&lt;b style=&#39;font-size:16px&#39;&gt;Submitting an application — synchronous path (Gateway → Eureka → candidature → candidat / job)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color:#555555&#39;&gt;Lina (candidate #4) applies to job #1 “Java Spring Boot Developer” from the mobile app.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="4" width="1400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="sc-a2" value="&lt;b&gt;Client app&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Lina · role CANDIDATE&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="64" width="150" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sc-a3" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;:8080&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#1BA1E2;strokeColor=#006EAF;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="64" width="150" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sc-a4" value="&lt;b&gt;Eureka Server&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;:8761&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#FAD7AC;strokeColor=#B46504;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="64" width="150" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sc-a5" value="&lt;b&gt;candidature&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;MS3 · :8085&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="64" width="150" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sc-a6" value="&lt;b&gt;candidat&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;MS1 · :8081&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="64" width="150" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sc-a7" value="&lt;b&gt;job&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;MS2 · :8082&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="64" width="150" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sc-a8" value="&lt;b&gt;candidature_db&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;MySQL&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1100" y="64" width="150" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sc-a9" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;exchange jobboard.events&lt;/span&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=48;fillColor=#FFF3E0;strokeColor=#FF6600;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="64" width="150" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sc-a10" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="270" y="170" width="10" height="670" as="geometry" />
        </mxCell>
        <mxCell id="sc-a11" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="630" y="340" width="10" height="465" as="geometry" />
        </mxCell>
        <mxCell id="sc-a12" value="&lt;b&gt;0&lt;/b&gt; · At start-up every service registers in Eureka (heartbeat every 30 s) and keeps a cached copy of the registry." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=middle;spacingLeft=8;spacingTop=4;fontSize=11;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="215" y="120" width="1250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sc-a13" value="&lt;b&gt;1&lt;/b&gt; · POST /api/applications&lt;br&gt;{candidateId: 4, jobId: 1, motivation} + Bearer JWT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="180" as="sourcePoint" />
            <mxPoint x="270" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a14" value="&lt;b&gt;2&lt;/b&gt; · check the JWT (Keycloak keys, role CANDIDATE)&lt;br&gt;route /api/applications/** → lb://CANDIDATURE" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;fontSize=10;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="200" as="sourcePoint" />
            <mxPoint x="280" y="226" as="targetPoint" />
            <Array as="points">
              <mxPoint x="315" y="200" />
              <mxPoint x="315" y="226" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a15" value="&lt;b&gt;3&lt;/b&gt; · where is CANDIDATURE?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="270" as="sourcePoint" />
            <mxPoint x="450" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a16" value="instances (cached registry)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="295" as="sourcePoint" />
            <mxPoint x="280" y="295" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a17" value="&lt;b&gt;4&lt;/b&gt; · forward to one instance (load balancing)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="340" as="sourcePoint" />
            <mxPoint x="630" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a18" value="&lt;b&gt;5&lt;/b&gt; · where are CANDIDAT and JOB?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="385" as="sourcePoint" />
            <mxPoint x="460" y="385" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a19" value="addresses (cached registry)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="410" as="sourcePoint" />
            <mxPoint x="630" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a20" value="&lt;b&gt;6&lt;/b&gt; · GET /api/candidates/4&lt;br&gt;&lt;i&gt;(OpenFeign)&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="460" as="sourcePoint" />
            <mxPoint x="810" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a21" value="200 Candidate (404 if unknown)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="485" as="sourcePoint" />
            <mxPoint x="640" y="485" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a22" value="&lt;b&gt;7&lt;/b&gt; · GET /api/jobs/1 &lt;i&gt;(OpenFeign)&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#10739E;fontColor=#10739E;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="535" as="sourcePoint" />
            <mxPoint x="990" y="535" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a23" value="200 Job · available = true" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="560" as="sourcePoint" />
            <mxPoint x="640" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a24" value="&lt;b&gt;8&lt;/b&gt; · business rules: job open? already applied?&lt;br&gt;date ≤ today? (else 409 / 400)" style="html=1;align=left;spacingLeft=4;endArrow=block;endFill=1;rounded=0;fontSize=10;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="585" as="sourcePoint" />
            <mxPoint x="640" y="611" as="targetPoint" />
            <Array as="points">
              <mxPoint x="675" y="585" />
              <mxPoint x="675" y="611" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a25" value="&lt;b&gt;9&lt;/b&gt; · INSERT candidature (SUBMITTED)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="655" as="sourcePoint" />
            <mxPoint x="1170" y="655" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a26" value="id = 6" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="680" as="sourcePoint" />
            <mxPoint x="640" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a27" value="&lt;b&gt;10&lt;/b&gt; · publish ApplicationSubmitted &lt;i&gt;(does not wait)&lt;/i&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;fontColor=#2D7600;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="730" as="sourcePoint" />
            <mxPoint x="1350" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a28" value="&lt;b&gt;11&lt;/b&gt; · 201 Created · Location: /api/applications/6" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="790" as="sourcePoint" />
            <mxPoint x="280" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a29" value="201 Created + CandidatureResponse" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;rounded=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="270" y="830" as="sourcePoint" />
            <mxPoint x="100" y="830" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sc-a30" value="&lt;b&gt;Error cases&lt;/b&gt;&lt;br&gt;• 401 / 403 at the gateway: missing token / wrong role&lt;br&gt;• 404: candidate or job not found (FeignException.NotFound)&lt;br&gt;• 409: job closed or already applied&lt;br&gt;• 400: applicationDate in the future&lt;br&gt;• 503: CANDIDAT or JOB unavailable (service stopped, not in Eureka)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="890" width="700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sc-a31" value="&lt;b&gt;What to remember&lt;/b&gt;&lt;br&gt;• Steps 1 → 11 are &lt;b&gt;synchronous&lt;/b&gt;: the client waits for every call.&lt;br&gt;• Eureka is a &lt;b&gt;directory, not a proxy&lt;/b&gt;: requests go straight to the chosen instance.&lt;br&gt;• candidature stores only &lt;b&gt;candidateId&lt;/b&gt; and &lt;b&gt;jobId&lt;/b&gt;: the rest is read again from CANDIDAT and JOB.&lt;br&gt;• Step 10 only drops a message in RabbitMQ: the e-mail and the interview happen later (page &lt;i&gt;async-communication&lt;/i&gt;)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="890" width="700" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="async-communication" id="ac">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ac-a1" value="&lt;b style=&#39;font-size:16px&#39;&gt;Asynchronous communication — RabbitMQ (pilot scenario of Chapter 6)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color:#555555&#39;&gt;candidature publishes ApplicationSubmitted; notification (and meeting, bonus) react later, without blocking the candidate.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="4" width="1380" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ac-a2" value="&lt;b&gt;RabbitMQ broker&lt;/b&gt; — Docker &lt;i&gt;rabbitmq:4.3-management&lt;/i&gt; · AMQP :5672 · management UI :15672 (awd / awd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF6600;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=50;spacingTop=12;fontSize=11;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="790" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ac-a3" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ac-a2">
          <mxGeometry x="12" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ac-prod" value="&lt;b&gt;MS3 · candidature&lt;/b&gt;&lt;br&gt;producer (Spring AMQP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;spacingLeft=40;fontSize=11;arcSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="293" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ac-a4" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ac-prod">
          <mxGeometry x="8" y="22.0" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ac-a5" value="&lt;b&gt;Exchange&lt;/b&gt;&lt;br&gt;&lt;b&gt;jobboard.events&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;topic · durable&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.14;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="273" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ac-a6" value="&lt;b&gt;meeting.application-submitted&lt;/b&gt;  &lt;i&gt;(bonus)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;verticalLabelPosition=top;verticalAlign=bottom;fontSize=11;labelPosition=center;align=center;" vertex="1" parent="1">
