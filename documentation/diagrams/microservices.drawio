        </mxCell>
        <mxCell id="ac-a10" value="" style="shape=message;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="ac-a6">
          <mxGeometry x="150" y="16" width="36" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ac-a11" value="" style="shape=message;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="ac-a6">
          <mxGeometry x="196" y="16" width="36" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ac-a12" value="queue" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=9;fontColor=#E65100;align=right;" vertex="1" parent="ac-a6">
          <mxGeometry x="240" y="18" width="56" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ac-a13" value="&lt;b&gt;notification.application-submitted&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;verticalLabelPosition=top;verticalAlign=bottom;fontSize=11;labelPosition=center;align=center;" vertex="1" parent="1">
