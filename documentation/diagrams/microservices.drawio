        <mxCell id="kc-a16" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;endFill=1;fontSize=10;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2D7600;fontColor=#2D7600;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="kc-a6" target="kc-a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kc-a17" value="&lt;span style=&#39;background-color:#7E0C6E;color:#ffffff;border-radius:9px;padding:1px 6px;font-weight:bold;&#39;&gt;8&lt;/span&gt; response&lt;br&gt;(401 no / bad token · 403 wrong role)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="kc-a16">
          <mxGeometry x="0" relative="1" as="geometry">
