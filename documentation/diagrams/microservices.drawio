      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kc-a1" value="&lt;b style=&#39;font-size:16px&#39;&gt;Keycloak — securing the JobBoard with an API Gateway (OAuth2 / OpenID Connect + JWT)&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color:#555555&#39;&gt;The application gets a token from Keycloak; the gateway checks it on every request before routing.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=11;" vertex="1" parent="1">
