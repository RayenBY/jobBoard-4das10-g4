          <mxGeometry x="12" y="16" width="36" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ac-a8" value="" style="shape=message;html=1;whiteSpace=wrap;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="ac-a6">
